---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroReel from '../components/sections/HeroReel.astro';
import SelectedWorks from '../components/sections/SelectedWorks.astro';
import StudioPillars from '../components/sections/StudioPillars.astro';
import ClientRoster from '../components/sections/ClientRoster.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Faq from '../components/sections/Faq.astro';
import { getCollection } from 'astro:content';

const capabilities = [
  { title: 'Web and App Development', text: 'Custom-built, fast, and scalable digital platforms designed to grow with you.' },
  { title: 'Design Systems', text: 'Scalable design frameworks for brand consistency across all touchpoints.' },
  { title: 'UI/UX Design', text: 'Intuitive, user-first interfaces that drive engagement and conversion.' },
  { title: 'CMS Integration', text: 'Flexible content management solutions built for ease and speed.' },
  { title: 'E-commerce Development', text: 'Seamless shopping experiences built for speed, trust, and sales.' },
  { title: 'API Development', text: 'Connect systems and apps with seamless backend integrations.' },
];

const webSolutions = [
  { label: 'CMS solutions', count: 8 },
  { label: 'API development', count: 10 },
  { label: 'Mobile applications', count: 1 },
  { label: 'E-commerce solutions', count: 2 },
  { label: 'ERPNext Solution', count: 10 },
];

const values = [
  { n: '01', title: 'Innovate Fearlessly', text: 'We craft smart, future-ready digital solutions.' },
  { n: '02', title: 'Empower Businesses', text: 'Technology that fuels growth and efficiency.' },
  { n: '03', title: 'Elevate User Experience', text: 'Designs that connect, engage, and convert.' },
  { n: '04', title: 'Build Trusted Partnerships', text: 'Long-term collaboration, real results.' },
  { n: '05', title: 'Deliver Impact', text: 'Focused on value, outcomes, and success.' },
];

const latestPosts = (await getCollection('journal')).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout title="Crayonweb Studio: Digital Studio, Bhavnagar and Worldwide">
  <HeroReel />

  <section class="mx-auto max-w-[1440px] px-5 py-16 md:px-10">
    <div class="overflow-hidden rounded-lg border border-hairline">
      <div class="flex items-baseline justify-between gap-6 bg-ink p-8 text-canvas md:p-10">
        <p class="font-display text-5xl font-semibold md:text-6xl">150+</p>
        <p class="text-sm text-white/70">Total Projects</p>
      </div>
      <p class="border-t border-hairline bg-canvas px-8 pt-6 text-xs font-medium uppercase tracking-[0.2em] text-muted">Web Solutions</p>
      <div class="grid gap-px bg-hairline sm:grid-cols-2 md:grid-cols-5">
        {webSolutions.map((s) => (
          <div class="bg-canvas p-8">
            <p class="font-display text-4xl font-semibold">{s.count}</p>
            <p class="mt-2 text-sm text-muted">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SelectedWorks />

  <section class="mx-auto max-w-[1440px] px-5 py-24 md:px-10 md:py-32">
    <p class="text-xs uppercase tracking-[0.2em] text-muted">Our Capabilities</p>
    <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold leading-tight tracking-tight md:text-5xl">We blend creativity, strategy, and technology to build digital experiences that matter.</h2>
    <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-hairline bg-hairline md:grid-cols-2 lg:grid-cols-3">
      {capabilities.map((c) => (
        <div class="bg-canvas p-8">
          <h3 class="font-display text-xl font-semibold">{c.title}</h3>
          <p class="mt-3 leading-relaxed text-muted">{c.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-y border-hairline bg-surface/60">
    <div class="mx-auto max-w-[1440px] px-5 py-24 md:px-10 md:py-32">
      <p class="text-xs uppercase tracking-[0.2em] text-muted">Our Journey So Far</p>
      <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight md:text-5xl">Creative branding services designed to elevate your business.</h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">Our journey as a creative digital platform is rooted in innovation, growth, and delivering impactful IT solutions. From humble beginnings to helping global brands, we have evolved by turning ideas into powerful digital experiences.</p>
      <a href="/studio" class="mt-8 inline-block rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas">Read more</a>
    </div>
  </section>

  <StudioPillars />

  <ClientRoster />

  <section class="mx-auto max-w-[1440px] px-5 py-24 md:px-10 md:py-32">
    <p class="text-xs uppercase tracking-[0.2em] text-muted">We are driven by purpose, powered by creativity, and committed to digital excellence</p>
    <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight md:text-4xl">What we stand for.</h2>
    <div class="mt-10">
      {values.map((v) => (
        <article class="grid gap-3 border-t border-hairline py-8 md:grid-cols-12 md:gap-6">
          <span class="font-display text-sm font-semibold text-muted md:col-span-1">{v.n}</span>
          <h3 class="font-display text-2xl font-semibold md:col-span-4">{v.title}</h3>
          <p class="leading-relaxed text-muted md:col-span-7">{v.text}</p>
        </article>
      ))}
    </div>
  </section>

  <Testimonials />

  <Faq />

  <section class="mx-auto max-w-[1440px] px-5 py-24 md:px-10 md:py-32">
    <p class="text-xs uppercase tracking-[0.2em] text-muted">Fresh ideas. Real impact.</p>
    <div class="flex items-end justify-between gap-6">
      <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight md:text-5xl">Latest Stories and Studio Updates</h2>
      <a href="/journal" class="shrink-0 text-sm font-medium underline underline-offset-4">All articles</a>
    </div>
    <p class="mt-4 max-w-2xl leading-relaxed text-muted">Stay inspired and informed with our latest blogs on design, technology, branding, and innovation, written by creatives who build what they believe in.</p>
    <div class="mt-12">
      {latestPosts.map((p) => (
        <a href={`/journal/${p.id.replace(/\.md$/, '')}`} class="group block border-t border-hairline py-8 first:border-t-0">
          <div class="grid gap-4 md:grid-cols-12 md:gap-8">
            <p class="text-sm tabular-nums text-muted md:col-span-2">{p.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
            <div class="md:col-span-8">
              <h3 class="font-display text-2xl font-semibold tracking-tight transition-colors group-hover:underline md:text-3xl">{p.data.title}</h3>
              <p class="mt-3 text-sm text-muted">by {p.data.author}{p.data.category ? `, ${p.data.category}` : ''}</p>
            </div>
            <span class="hidden text-2xl md:col-span-2 md:block md:text-right" aria-hidden="true">&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
