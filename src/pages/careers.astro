---
import BaseLayout from '../layouts/BaseLayout.astro';
import ApplyForm from '../components/careers/ApplyForm.astro';
import { roles } from '../content/careers';
---

<BaseLayout title="Careers: Crayonweb Studio" description="Join Crayonweb and be part of a creative digital agency where innovation meets impact. Open roles in UI/UX design, front-end development, SEO, and business development in Bhavnagar, Gujarat.">
  <section class="mx-auto max-w-[1440px] px-5 pb-24 pt-12 md:px-10 md:pt-16">
    <p class="text-xs uppercase tracking-[0.2em] text-muted">Careers</p>
    <h1 class="mt-4 max-w-4xl font-display text-[clamp(2.4rem,5vw,4.2rem)] font-semibold leading-[1.05] tracking-tight">Tell your career story visually and effectively with Crayonweb, a digital agency specializing in creative storytelling solutions.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">Join Crayonweb and be part of a creative digital agency where innovation meets impact. We craft visually compelling digital experiences and career stories, and we are looking for talented individuals to help us shape the future of web design, TYPO3 development, and digital storytelling. Grow your career with opportunities to learn, create, and make a difference.</p>

    <section class="mt-16">
      <p class="text-xs uppercase tracking-[0.2em] text-muted">Join our growing family of innovators</p>
      <div class="mt-6 grid gap-8 md:grid-cols-2">
        <p class="leading-relaxed text-muted">At Crayonweb, we are more than just a digital agency. We are a vibrant, innovative, and inclusive community where creativity meets technology. Our team consists of creative artists, web developers, web designers, ERP specialists, TYPO3 experts, and mobile app developers, all working together to craft visually compelling and high-performing digital solutions for businesses around the world. Joining Crayonweb means becoming part of a family that values your ideas, nurtures your growth, and celebrates every achievement.</p>
        <p class="leading-relaxed text-muted">We believe that a strong, collaborative culture is the heart of great work. Our environment encourages transparency, teamwork, and continuous learning. Every voice matters, and every contribution counts. From creative brainstorming sessions and design workshops to technical skill-building and mentorship programs, we ensure that every team member has the opportunity to grow professionally and personally.</p>
        <p class="leading-relaxed text-muted">Innovation drives everything we do. At Crayonweb, you will work on exciting projects spanning web design, TYPO3 development, mobile applications, ERP solutions, and digital marketing campaigns. You will have the freedom to experiment with the latest tools and technologies, develop your skills on challenging projects, and push the boundaries of digital experiences. Our culture rewards curiosity, initiative, and ownership, empowering team members to deliver meaningful results that make a real impact.</p>
        <p class="leading-relaxed text-muted">We also understand the importance of balance. Flexibility, recognition, and a supportive environment ensure that creativity thrives. Whether collaborating remotely or in-office, our inclusive workspace enables everyone to do their best work while feeling valued and inspired.</p>
      </div>
    </section>

    <section class="mt-20">
      <h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl">Current job openings</h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-muted">Looking for your next career move? Crayonweb is seeking talented professionals in web design, development, and digital solutions. Apply now and be part of our growing team.</p>

      <div class="mt-10 space-y-4">
        {roles.map((role, i) => (
          <details class="group rounded-xl border border-hairline bg-white">
            <summary class="flex cursor-pointer list-none flex-wrap items-center justify-between gap-3 px-6 py-5 md:px-8">
              <span class="flex items-baseline gap-4">
                <span class="font-display text-sm font-semibold text-muted">0{i + 1}</span>
                <span class="font-display text-xl font-semibold md:text-2xl">{role.title}</span>
              </span>
              <span class="flex flex-wrap items-center gap-4">
                <a href={`/careers/${role.slug}`} class="group/apply inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2 text-sm font-medium text-canvas transition-colors hover:bg-accent hover:text-ink">
                  Apply
                  <span class="transition-transform group-hover/apply:translate-x-0.5" aria-hidden="true">&rarr;</span>
                </a>
                <span class="text-sm text-muted">{role.type} &middot; {role.location} &middot; {role.vacancies} {role.vacancies === '01' ? 'vacancy' : 'vacancies'}</span>
              </span>
            </summary>
            <div class="border-t border-hairline px-6 py-8 md:px-8">
              <p class="max-w-3xl leading-relaxed text-muted">{role.summary}</p>

              <dl class="mt-8 grid grid-cols-2 gap-6 border-y border-hairline py-6 md:grid-cols-4">
                <div><dt class="text-xs uppercase tracking-[0.2em] text-muted">Experience</dt><dd class="mt-2 text-sm font-medium">{role.experience}</dd></div>
                <div><dt class="text-xs uppercase tracking-[0.2em] text-muted">Working hours</dt><dd class="mt-2 text-sm font-medium">{role.hours}</dd></div>
                <div><dt class="text-xs uppercase tracking-[0.2em] text-muted">Working days</dt><dd class="mt-2 text-sm font-medium">{role.days}</dd></div>
                <div><dt class="text-xs uppercase tracking-[0.2em] text-muted">Salary</dt><dd class="mt-2 text-sm font-medium">{role.salary}</dd></div>
              </dl>

              {role.about.map((p) => (
                <p class="mt-5 max-w-3xl leading-relaxed text-muted">{p}</p>
              ))}

              <h3 class="mt-10 font-display text-xl font-semibold">Requirements</h3>
              <p class="mt-3 text-sm text-muted">Experience: at least 1 year.</p>
              {role.requirements.map((group) => (
                <div class="mt-6">
                  <h4 class="font-display text-base font-semibold">{group.heading}</h4>
                  <ul class="mt-3 space-y-2">
                    {group.items.map((item) => (
                      <li class="flex gap-3 text-sm leading-relaxed text-muted"><span class="text-ink" aria-hidden="true">&rarr;</span>{item}</li>
                    ))}
                  </ul>
                </div>
              ))}

              <div class="mt-10 flex flex-wrap items-center gap-4">
                <a href={`/careers/${role.slug}`} class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas">Apply for this role</a>
                <a href="mailto:hr@crayonwebstudio.com?subject=Application%20for%20{encodeURIComponent(role.title)}" class="text-sm font-medium underline underline-offset-4">Email your CV to hr@crayonwebstudio.com</a>
              </div>

              <ApplyForm role={role.title} prefix={`list-${i}`} />
            </div>
          </details>
        ))}
      </div>
    </section>
  </section>
</BaseLayout>
<script>
  document.querySelectorAll('.apply-form').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const first = String(data.get('firstName') || '').trim();
      const last = String(data.get('lastName') || '').trim();
      const email = String(data.get('email') || '').trim();
      const phone = String(data.get('phone') || '').trim();
      const exp = String(data.get('experience') || '').trim();
      const valid = first.length > 1 && last.length > 1 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) && phone.length > 5 && exp.length > 0;
      const err = form.querySelector('.apply-error');
      if (!valid) { err?.classList.remove('hidden'); return; }
      err?.classList.add('hidden');
      form.querySelector('.apply-success')?.classList.remove('hidden');
      form.querySelector('button[type="submit"]')?.classList.add('hidden');
    });
  });
</script>
