---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('lab')).sort((a, b) => b.data.year - a.data.year);
const filters = ['All', 'Branding', 'UI/UX', 'Motion', 'TYPO3'];
const aspectClass = { square: 'aspect-square', portrait: 'aspect-[3/4]', landscape: 'aspect-[16/10]' } as const;
---

<BaseLayout title="Lab: Crayonweb Studio">
  <section class="mx-auto max-w-[1440px] px-5 pb-24 pt-12 md:px-10 md:pt-16">
    <p class="text-xs uppercase tracking-[0.2em] text-muted">The Lab</p>
    <h1 class="mt-4 font-display text-[clamp(2.6rem,6vw,4.8rem)] font-semibold leading-[1.02] tracking-tight">Experiments,<br />in progress.</h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">Branding, interface, motion, and TYPO3 studies from the studio. Some ship to clients, some stay as studies.</p>
    <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter lab">
      {filters.map((f) => (
        <button type="button" class="lab-filter rounded-full border border-hairline px-4 py-2 text-sm transition-colors" data-filter={f} aria-pressed={f === 'All'}>{f}</button>
      ))}
    </div>
    <div class="mt-12 columns-1 gap-6 sm:columns-2 lg:columns-3" id="lab-grid">
      {items.map((item) => (
        <figure class="lab-item mb-6 break-inside-avoid" data-category={item.data.category}>
          <div class:list={['relative overflow-hidden rounded-lg', aspectClass[item.data.aspectRatio]]} style={`background: ${item.data.cover}`}>
            <span class="absolute inset-0 flex items-center justify-center p-6 text-center font-display text-xl font-semibold text-white/90 md:text-2xl">{item.data.title}</span>
            <span class="absolute left-4 top-4 rounded-full bg-canvas/90 px-3 py-1 text-xs font-medium">{item.data.category}</span>
          </div>
          <figcaption class="mt-3 flex items-baseline justify-between gap-4">
            <span class="font-medium">{item.data.title}</span>
            <span class="shrink-0 text-sm tabular-nums text-muted">{item.data.year}</span>
          </figcaption>
          <p class="mt-1 text-sm text-muted">{item.data.description}</p>
        </figure>
      ))}
    </div>
    <p id="lab-empty" class="mt-12 hidden text-muted">No experiments in this category yet.</p>
  </section>
</BaseLayout>
<script>
  const buttons = Array.from(document.querySelectorAll('.lab-filter'));
  const items = Array.from(document.querySelectorAll('.lab-item'));
  const empty = document.getElementById('lab-empty');
  function paint(active) {
    buttons.forEach((b) => {
      const on = b.dataset.filter === active;
      b.setAttribute('aria-pressed', String(on));
      b.style.background = on ? '#0A0A0A' : 'transparent';
      b.style.color = on ? '#FAFAFA' : '#0A0A0A';
    });
  }
  paint('All');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filter || 'All';
    paint(f);
    let visible = 0;
    items.forEach((item) => {
      const show = f === 'All' || item.dataset.category === f;
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (empty) empty.classList.toggle('hidden', visible > 0);
  }));
</script>
