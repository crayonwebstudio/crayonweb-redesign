---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../content/services';
const platforms = ['TYPO3 CMS', 'Node JS', 'Next JS', 'Wordpress', 'Flutter', 'React Native', 'Magento', 'Shopify', 'ERPNext', 'Storyblok Headless CMS', 'Strapi Headless CMS'];
---

<BaseLayout title="Services: Crayonweb Studio" description="Comprehensive digital services tailored to your business growth. TYPO3 development, web design, branding, digital marketing, CMS, mobile apps, media creation, and AI-powered business solutions.">
  <section class="mx-auto max-w-[1440px] px-5 pb-24 pt-12 md:px-10 md:pt-16">
    <p class="text-xs uppercase tracking-[0.2em] text-muted">Services</p>
    <h1 class="mt-4 max-w-4xl font-display text-[clamp(2.6rem,6vw,4.8rem)] font-semibold leading-[1.02] tracking-tight">Comprehensive digital services tailored to your business growth.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">Crayonweb is a creative digital agency that transforms ideas into visually compelling stories. We specialize in TYPO3 development, TYPO3 support, and ongoing website maintenance to ensure your business stays fast, secure, and scalable. Our services include responsive web design, custom TYPO3 extensions, branding, and digital marketing solutions, all designed to deliver seamless user experiences and measurable growth. With a focus on creativity and technology, Crayonweb helps businesses build a powerful online presence and achieve long-term success.</p>

    <div class="mt-14 grid gap-px overflow-hidden rounded-lg border border-hairline bg-hairline md:grid-cols-2">
      {services.map((s, i) => (
        <a href={`/service/${s.slug}`} class="group block bg-canvas p-8 transition-colors hover:bg-surface" data-cursor="View Service">
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-display text-sm font-semibold text-muted">0{i + 1}</span>
            <span class="text-muted transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">&nearr;</span>
          </div>
          <h2 class="mt-6 font-display text-2xl font-semibold">{s.title}</h2>
          <p class="mt-3 leading-relaxed text-muted">{s.short}</p>
        </a>
      ))}
    </div>

    <section class="mt-20">
      <p class="text-xs uppercase tracking-[0.2em] text-muted">Platforms we work with</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {platforms.map((p) => (
          <li class="rounded-full border border-hairline bg-surface px-4 py-2 text-sm">{p}</li>
        ))}
      </ul>
    </section>

    <div class="mt-16 flex flex-wrap gap-3">
      <a href="/work" class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas">See the work</a>
      <a href="/contact" class="rounded-full border border-ink px-6 py-3 text-sm font-medium">Start a project</a>
    </div>
  </section>
</BaseLayout>
