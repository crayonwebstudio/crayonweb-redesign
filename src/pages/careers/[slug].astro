---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ApplyForm from '../../components/careers/ApplyForm.astro';
import { roles } from '../../content/careers';

export function getStaticPaths() {
  return roles.map((role) => ({ params: { slug: role.slug }, props: { role } }));
}

const { role } = Astro.props;
const index = roles.findIndex((r) => r.slug === role.slug);
const next = roles[(index + 1) % roles.length];
---

<BaseLayout title={`${role.title}: Crayonweb Studio`} description={role.summary}>
  <section class="mx-auto max-w-[1440px] px-5 pb-24 pt-12 md:px-10 md:pt-16">
    <a href="/careers" class="text-sm font-medium underline underline-offset-4">&larr; All job openings</a>

    <p class="mt-10 text-xs uppercase tracking-[0.2em] text-muted">Careers &middot; {role.type} &middot; {role.location}</p>
    <h1 class="mt-4 max-w-4xl font-display text-[clamp(2.4rem,5vw,4.2rem)] font-semibold leading-[1.05] tracking-tight">{role.title}</h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted">{role.summary}</p>

    <dl class="mt-10 grid grid-cols-2 gap-6 border-y border-hairline py-6 md:grid-cols-4">
      <div><dt class="text-xs uppercase tracking-[0.2em] text-muted">Experience</dt><dd class="mt-2 text-sm font-medium">{role.experience}</dd></div>
      <div><dt class="text-xs uppercase tracking-[0.2em] text-muted">Working hours</dt><dd class="mt-2 text-sm font-medium">{role.hours}</dd></div>
      <div><dt class="text-xs uppercase tracking-[0.2em] text-muted">Working days</dt><dd class="mt-2 text-sm font-medium">{role.days}</dd></div>
      <div><dt class="text-xs uppercase tracking-[0.2em] text-muted">Salary</dt><dd class="mt-2 text-sm font-medium">{role.salary}</dd></div>
    </dl>
    <p class="mt-6 text-sm text-muted">{role.vacancies} {role.vacancies === '01' ? 'vacancy' : 'vacancies'} open &middot; {role.type} &middot; {role.location}</p>

    {role.about.map((p) => (
      <p class="mt-6 max-w-3xl leading-relaxed text-muted">{p}</p>
    ))}

    <h2 class="mt-12 font-display text-2xl font-semibold tracking-tight md:text-3xl">Requirements</h2>
    <p class="mt-3 text-sm text-muted">Experience: at least 1 year.</p>
    {role.requirements.map((group) => (
      <div class="mt-8">
        <h3 class="font-display text-lg font-semibold">{group.heading}</h3>
        <ul class="mt-4 space-y-2">
          {group.items.map((item) => (
            <li class="flex gap-3 text-sm leading-relaxed text-muted"><span class="text-ink" aria-hidden="true">&rarr;</span>{item}</li>
          ))}
        </ul>
      </div>
    ))}

    <div class="mt-12 flex flex-wrap items-center gap-4">
      <a href="#apply" class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas">Apply for this role</a>
      <a href={`mailto:hr@crayonwebstudio.com?subject=Application%20for%20${encodeURIComponent(role.title)}`} class="text-sm font-medium underline underline-offset-4">Email your CV to hr@crayonwebstudio.com</a>
    </div>

    <div id="apply">
      <ApplyForm role={role.title} prefix="detail" />
    </div>

    <div class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-hairline pt-8">
      <a href="/careers" class="text-sm font-medium underline underline-offset-4">&larr; Back to all openings</a>
      <a href={`/careers/${next.slug}`} class="text-sm font-medium underline underline-offset-4">Next role: {next.title} &rarr;</a>
    </div>
  </section>
</BaseLayout>
<script>
  document.querySelectorAll('.apply-form').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const first = String(data.get('firstName') || '').trim();
      const last = String(data.get('lastName') || '').trim();
      const email = String(data.get('email') || '').trim();
      const phone = String(data.get('phone') || '').trim();
      const exp = String(data.get('experience') || '').trim();
      const valid = first.length > 1 && last.length > 1 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) && phone.length > 5 && exp.length > 0;
      const err = form.querySelector('.apply-error');
      if (!valid) { err?.classList.remove('hidden'); return; }
      err?.classList.add('hidden');
      form.querySelector('.apply-success')?.classList.remove('hidden');
      form.querySelector('button[type="submit"]')?.classList.add('hidden');
    });
  });
</script>
