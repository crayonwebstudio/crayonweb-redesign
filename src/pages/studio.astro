---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioPillars from '../components/sections/StudioPillars.astro';
const principles = [
  { n: '01', title: 'Innovate Fearlessly', text: 'We try the new tool, the new pattern, the new approach, on our own time first, so clients get proven ideas, not experiments.' },
  { n: '02', title: 'Empower Businesses', text: 'Technology should give a business leverage, not dependency. We build systems clients can run themselves.' },
  { n: '03', title: 'Elevate UX', text: 'Every interface earns its place. If a screen does not help the person using it, it does not ship.' },
  { n: '04', title: 'Trusted Partnerships', text: 'Most of our work comes from clients who stay. Clear pricing, honest timelines, and work we stand behind.' },
  { n: '05', title: 'Deliver Impact', text: 'Design and code are means, not ends. We measure success by what changes for the client: sales, speed, clarity.' },
];
---

<BaseLayout title="Studio: Crayonweb Studio">
  <section class="mx-auto max-w-[1440px] px-5 pb-16 pt-36 md:px-10 md:pt-44">
    <p class="text-xs uppercase tracking-[0.2em] text-muted">Studio</p>
    <h1 class="mt-4 max-w-4xl font-display text-[clamp(2.6rem,6vw,4.8rem)] font-semibold leading-[1.02] tracking-tight">A small studio in Bhavnagar, building for the world.</h1>
    <div class="mt-10 grid gap-10 md:grid-cols-2">
      <p class="text-lg leading-relaxed text-muted">Crayonweb Studio Pvt. Ltd. began as a web studio in Bhavnagar, Gujarat, and grew into a full service digital studio serving clients across Germany, Austria, Switzerland, the Netherlands, the USA, and India. We stay deliberately small: one team, senior people, no layers between the client and the work.</p>
      <p class="text-lg leading-relaxed text-muted">Our work spans brand and UI, TYPO3 and headless web, e-commerce and ERP, and mobile and AI. What ties it together is a belief that good software is calm, fast, and honest, and that a studio earns trust by shipping, then staying to care for what it shipped.</p>
    </div>
    <div class="mt-14 grid gap-px overflow-hidden rounded-lg border border-hairline bg-hairline md:grid-cols-3">
      <div class="bg-canvas p-8"><p class="font-display text-4xl font-semibold">20+</p><p class="mt-2 text-sm text-muted">Projects shipped across web, commerce, and ERP</p></div>
      <div class="bg-canvas p-8"><p class="font-display text-4xl font-semibold">6</p><p class="mt-2 text-sm text-muted">Countries served, from DACH to India</p></div>
      <div class="bg-canvas p-8"><p class="font-display text-4xl font-semibold">360</p><p class="mt-2 text-sm text-muted">Annual care: support, updates, and improvement</p></div>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-5 py-16 md:px-10">
    <p class="text-xs uppercase tracking-[0.2em] text-muted">Principles</p>
    <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight md:text-4xl">Five principles, kept daily.</h2>
    <div class="mt-10">
      {principles.map((p) => (
        <article class="grid gap-3 border-t border-hairline py-8 md:grid-cols-12 md:gap-6">
          <span class="font-display text-sm font-semibold text-muted md:col-span-1">{p.n}</span>
          <h3 class="font-display text-2xl font-semibold md:col-span-4">{p.title}</h3>
          <p class="leading-relaxed text-muted md:col-span-7">{p.text}</p>
        </article>
      ))}
    </div>
  </section>

  <StudioPillars />

  <section class="mx-auto max-w-[1440px] px-5 pb-24 md:px-10">
    <h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl">Team and culture</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-muted">Designers, developers, and project leads share one room and one standard: the work must be good enough to show, and clear enough to hand over. We document, we test, and we answer the phone when a client site needs us.</p>
    <h2 class="mt-16 font-display text-3xl font-semibold tracking-tight md:text-4xl">Global delivery, local care</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-muted">We work across time zones with European clients, with overlap hours agreed per project, weekly demos, and a single point of contact. Distance is handled by process, not by promises: shared boards, written decisions, and a staging link for every change.</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/work" class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas">See the work</a>
      <a href="/contact" class="rounded-full border border-ink px-6 py-3 text-sm font-medium">Talk to the studio</a>
    </div>
  </section>
</BaseLayout>
