---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import VideoHoverCard from '../../components/motion/VideoHoverCard.astro';
const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const filters = ['All', 'Web/TYPO3', 'E-Commerce', 'Brand/UI', 'Mobile'];
---

<BaseLayout title="Work: Crayonweb Studio">
  <section class="mx-auto max-w-[1440px] px-5 pb-24 pt-36 md:px-10 md:pt-44">
    <p class="text-xs uppercase tracking-[0.2em] text-muted">Work</p>
    <h1 class="mt-4 font-display text-[clamp(2.6rem,6vw,4.8rem)] font-semibold leading-[1.02] tracking-tight">Selected work,<br />2019 to 2026.</h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">Six flagship projects across TYPO3, headless web, e-commerce, ERP, and mobile. Each one shipped, live, and still cared for.</p>

    <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter work">
      {filters.map((f) => (
        <button type="button" class="work-filter rounded-full border border-hairline px-4 py-2 text-sm transition-colors" data-filter={f} aria-pressed={f === 'All'}>{f}</button>
      ))}
    </div>

    <div class="mt-12 grid gap-x-8 gap-y-16 md:grid-cols-12" id="work-grid">
      {works.map((w, i) => (
        <div class:list={['work-item md:col-span-6', i % 2 === 0 ? '' : 'md:mt-16']} data-category={w.data.category}>
          <VideoHoverCard
            href={`/work/${w.id.replace(/\.md$/, '')}`}
            cover={w.data.cover}
            initials={w.data.initials}
            title={w.data.title}
            disciplines={w.data.disciplines}
            year={w.data.year}
            aspect="aspect-[4/3]"
          />
          <p class="mt-3 text-sm leading-relaxed text-muted">{w.data.summary}</p>
          <p class="mt-1 text-sm text-muted">{w.data.region}</p>
        </div>
      ))}
    </div>
    <p id="work-empty" class="mt-12 hidden text-muted">No projects in this category yet.</p>
  </section>
</BaseLayout>
<script>
  const buttons = Array.from(document.querySelectorAll('.work-filter'));
  const items = Array.from(document.querySelectorAll('.work-item'));
  const empty = document.getElementById('work-empty');
  function paint(active) {
    buttons.forEach((b) => {
      const on = b.dataset.filter === active;
      b.setAttribute('aria-pressed', String(on));
      b.style.background = on ? '#0A0A0A' : 'transparent';
      b.style.color = on ? '#FAFAFA' : '#0A0A0A';
    });
  }
  paint('All');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filter || 'All';
    paint(f);
    let visible = 0;
    items.forEach((item) => {
      const show = f === 'All' || item.dataset.category === f;
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (empty) empty.classList.toggle('hidden', visible > 0);
  }));
</script>
