---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../content/services';

export function getStaticPaths() {
  return services.map((s, i) => ({
    params: { slug: s.slug },
    props: { service: s, next: services[(i + 1) % services.length] },
  }));
}
const { service, next } = Astro.props;
---

<BaseLayout title={`${service.title}: Crayonweb Studio`} description={service.short}>
  <article class="mx-auto max-w-[1440px] px-5 pb-24 pt-12 md:px-10 md:pt-16">
    <p class="text-xs uppercase tracking-[0.2em] text-muted"><a href="/services" class="hover:underline">Services</a></p>
    <h1 class="mt-4 max-w-4xl font-display text-[clamp(2.4rem,6vw,4.6rem)] font-semibold leading-[1.02] tracking-tight">{service.title}</h1>
    <p class="mt-6 max-w-2xl text-xl leading-relaxed text-muted">{service.intro}</p>

    {service.deliverables && (
      <div class="mt-12 border-y border-hairline py-8">
        <p class="text-xs uppercase tracking-[0.2em] text-muted">What is included</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {service.deliverables.map((d) => (
            <li class="rounded-full border border-hairline bg-surface px-4 py-2 text-sm">{d}</li>
          ))}
        </ul>
      </div>
    )}

    {service.sections.map((section) => (
      <section class="mt-14 max-w-3xl">
        <h2 class="font-display text-2xl font-semibold md:text-3xl">{section.heading}</h2>
        {section.paragraphs.map((p) => (
          <p class="mt-4 leading-relaxed text-muted">{p}</p>
        ))}
      </section>
    ))}

    {service.detailList && (
      <section class="mt-14">
        <h2 class="font-display text-2xl font-semibold md:text-3xl">In detail</h2>
        <div class="mt-8 grid gap-px overflow-hidden rounded-lg border border-hairline bg-hairline md:grid-cols-2">
          {service.detailList.map((d) => (
            <div class="bg-canvas p-8">
              <h3 class="font-display text-lg font-semibold">{d.heading}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{d.text}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {service.benefits && (
      <section class="mt-14 max-w-3xl">
        <h2 class="font-display text-2xl font-semibold md:text-3xl">Benefits</h2>
        <ul class="mt-6 space-y-3">
          {service.benefits.map((b) => (
            <li class="flex gap-3 leading-relaxed text-muted"><span class="text-ink" aria-hidden="true">&rarr;</span>{b}</li>
          ))}
        </ul>
      </section>
    )}

    {service.whyUs && (
      <section class="mt-14">
        <h2 class="font-display text-2xl font-semibold md:text-3xl">Why us</h2>
        <ul class="mt-6 flex flex-wrap gap-2">
          {service.whyUs.map((w) => (
            <li class="rounded-full border border-hairline bg-surface px-4 py-2 text-sm">{w}</li>
          ))}
        </ul>
      </section>
    )}

    {service.tags && (
      <section class="mt-14 max-w-3xl">
        <h2 class="font-display text-2xl font-semibold md:text-3xl">Tag Here</h2>
        <p class="mt-6 leading-relaxed text-muted">{service.tags.join(', ')}</p>
      </section>
    )}

    {service.faqs && (
      <section class="mt-14 max-w-3xl">
        <h2 class="font-display text-2xl font-semibold md:text-3xl">Frequently asked questions</h2>
        <div class="mt-8">
          {service.faqs.map((f, i) => (
            <details class="group border-t border-hairline py-6 last:border-b" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-baseline justify-between gap-4">
                <span class="font-display text-xl font-semibold">{f.q}</span>
                <span class="shrink-0 font-display text-2xl text-muted transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-4 leading-relaxed text-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <div class="mt-16 flex flex-wrap gap-3">
      <a href="/work" class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas">See related work</a>
      <a href="/contact" class="rounded-full border border-ink px-6 py-3 text-sm font-medium">Start a project</a>
    </div>

    <a href={`/service/${next.slug}`} class="mt-20 block border-t border-hairline pt-8" data-cursor="Next Service">
      <span class="text-xs uppercase tracking-[0.2em] text-muted">Next service</span>
      <span class="mt-3 block font-display text-3xl font-semibold tracking-tight md:text-5xl">{next.title} &rarr;</span>
      <span class="mt-2 block text-muted">{next.short}</span>
    </a>
  </article>
</BaseLayout>
