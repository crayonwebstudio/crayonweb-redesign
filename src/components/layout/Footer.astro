---
import { getCollection } from 'astro:content';
const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<footer class="border-t border-hairline bg-canvas">
  <div class="mx-auto max-w-[1440px] px-5 pb-10 pt-20 md:px-10 md:pt-28">
    <p class="text-xs uppercase tracking-[0.2em] text-muted">Next project</p>
    <a href="/contact" class="mt-4 block font-display text-[clamp(2.4rem,6vw,4.8rem)] font-semibold leading-[1.02] tracking-tight" data-cursor="Say hello">
      Got a project in mind?<br />Let&rsquo;s discuss.
    </a>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="mailto:info@crayonwebstudio.com" class="text-lg font-medium underline underline-offset-4">info@crayonwebstudio.com</a>
      <button id="copy-email" type="button" class="rounded-full border border-hairline bg-surface px-4 py-2 text-sm transition-colors hover:bg-accent">Copy email</button>
      <span id="copy-feedback" class="text-sm text-muted opacity-0 transition-opacity" role="status">Copied to clipboard.</span>
    </div>

    <div class="mt-20 grid gap-10 border-t border-hairline pt-12 md:grid-cols-4">
      <div>
        <img src="/logo/crayon-logo-dark.png" alt="Crayonweb Studio" width="279" height="85" class="h-12 w-auto" />
        <p class="mt-5 font-display text-base font-semibold">Crayonweb Studio Pvt. Ltd.</p>
        <address class="mt-3 text-sm not-italic leading-relaxed text-muted">
          319, 3rd Floor, Sagar Complex,<br />Jasonath Chowk,<br />Bhavnagar-364001, Gujarat, India
        </address>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="mailto:info@crayonwebstudio.com" class="hover:underline">info@crayonwebstudio.com</a></li>
          <li><a href="tel:+919624052424" class="hover:underline">+91 96240 52424</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-muted">Selected Works</p>
        <ul class="mt-4 space-y-2 text-sm">
          {works.map((w) => (
            <li><a href={`/work/${w.id.replace(/\.md$/, '')}`} class="hover:underline">{w.data.title}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-muted">Capabilities</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="/studio#pillars" class="hover:underline">Brand and UI/UX Design</a></li>
          <li><a href="/studio#pillars" class="hover:underline">Web, Headless and TYPO3</a></li>
          <li><a href="/studio#pillars" class="hover:underline">E-Commerce and ERP</a></li>
          <li><a href="/studio#pillars" class="hover:underline">Mobile and AI Solutions</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-muted">Social</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="https://www.linkedin.com/company/crayonwebstudio" target="_blank" rel="noreferrer" class="hover:underline">LinkedIn</a></li>
          <li><a href="https://github.com/crayonwebstudio" target="_blank" rel="noreferrer" class="hover:underline">GitHub</a></li>
          <li><a href="https://dribbble.com" target="_blank" rel="noreferrer" class="hover:underline">Dribbble</a></li>
          <li><a href="https://x.com" target="_blank" rel="noreferrer" class="hover:underline">X</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-hairline pt-6 text-sm text-muted">
      <p>&copy; 2026 Crayonweb Studio Pvt. Ltd.</p>
      <p>Bhavnagar, India. Working worldwide.</p>
    </div>

    <div class="mt-12 rounded-xl border border-hairline bg-surface p-8 md:p-10">
      <p class="font-display text-2xl font-semibold">Subscribe Now.</p>
      <p class="mt-2 text-sm leading-relaxed text-muted">Stay inspired with studio notes, new work, and TYPO3 updates. This signup does not send anywhere yet. Your email stays in this browser until the newsletter backend is connected.</p>
      <form id="newsletter-form" class="mt-6 flex max-w-md flex-col gap-3 sm:flex-row" novalidate>
        <label for="newsletter-email" class="sr-only">Your email</label>
        <input id="newsletter-email" name="email" required type="email" autocomplete="email" placeholder="Your Mail" class="w-full rounded-lg border border-hairline bg-white px-4 py-3 text-sm outline-none focus:border-ink" />
        <button type="submit" class="shrink-0 rounded-lg bg-ink px-6 py-3 text-sm font-medium text-canvas">Subscribe</button>
      </form>
      <p id="newsletter-error" class="mt-3 hidden text-sm text-red-700">Please add a valid email address.</p>
      <p id="newsletter-success" class="mt-3 hidden text-sm font-medium">Thank you. Your subscription is noted locally, nothing was sent yet.</p>
    </div>
  </div>
</footer>
<script>
  const newsForm = document.getElementById('newsletter-form');
  newsForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('newsletter-email');
    const email = String(input?.value || '').trim();
    const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    document.getElementById('newsletter-error')?.classList.toggle('hidden', valid);
    if (!valid) return;
    document.getElementById('newsletter-success')?.classList.remove('hidden');
    newsForm?.classList.add('hidden');
  });
</script>
<script>
  const btn = document.getElementById('copy-email');
  const fb = document.getElementById('copy-feedback');
  btn?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText('info@crayonwebstudio.com'); } catch { /* clipboard unavailable */ }
    if (fb) { fb.style.opacity = '1'; setTimeout(() => { fb.style.opacity = '0'; }, 2000); }
    if (btn) { btn.textContent = 'Copied'; setTimeout(() => { btn.textContent = 'Copy email'; }, 2000); }
  });
</script>
