---
const pillars = [
  { n: '01', title: 'Brand and UI/UX Design', items: ['Art Direction', 'Visual Identity', 'Design Systems', 'Web and App Interfaces', 'Interactive Prototyping'] },
  { n: '02', title: 'Web, Headless and TYPO3', items: ['TYPO3 CMS Architecture', 'Headless CMS', 'Next.js and Astro Engineering', 'Performance Optimization', 'Annual 360 Care'] },
  { n: '03', title: 'E-Commerce and ERP', items: ['Magento 2 and Custom Storefronts', 'ERPNext Integrations', 'Marketplace Bridges', 'API Engineering'] },
  { n: '04', title: 'Mobile and AI Solutions', items: ['React Native, iOS and Android', 'AI-Powered Workflows', 'Process Automation', 'Scalable Cloud and DevOps'] },
];
---

<section id="pillars" class="mx-auto max-w-[1440px] px-5 py-24 md:px-10 md:py-32">
  <div class="grid gap-12 md:grid-cols-12">
    <div class="md:col-span-4">
      <div class="md:sticky md:top-28">
        <p class="text-xs uppercase tracking-[0.2em] text-muted">What we do</p>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl">Four pillars, one team, from first sketch to live product.</h2>
        <p class="mt-4 leading-relaxed text-muted">We are a full service studio, not a vendor list. Strategy, design, engineering, and care stay in one team, so nothing is lost between handoffs.</p>
        <a href="/studio" class="mt-6 inline-block text-sm font-medium underline underline-offset-4">More about the studio</a>
      </div>
    </div>
    <div class="md:col-span-8">
      {pillars.map((p) => (
        <article class="reveal-fade border-t border-hairline py-8 first:border-t-0 first:pt-0 md:py-10">
          <div class="flex items-baseline gap-6">
            <span class="font-display text-sm font-semibold text-muted">{p.n}</span>
            <h3 class="font-display text-2xl font-semibold tracking-tight md:text-3xl">{p.title}</h3>
          </div>
          <ul class="mt-4 flex flex-wrap gap-2 pl-10 md:pl-12">
            {p.items.map((item) => (
              <li class="rounded-full border border-hairline bg-surface px-3.5 py-1.5 text-sm">{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
