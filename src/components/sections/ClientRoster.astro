---
const regions = ['Germany', 'Austria', 'Switzerland', 'Netherlands', 'USA', 'India'];
---

<section class="border-y border-hairline bg-surface/60">
  <div class="mx-auto max-w-[1440px] px-5 py-24 md:px-10 md:py-32">
    <p class="text-xs uppercase tracking-[0.2em] text-muted">Global clients</p>
    <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold leading-tight tracking-tight md:text-5xl">Trusted across Europe and worldwide.</h2>
    <div class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-hairline bg-hairline md:grid-cols-3">
      {regions.map((r) => (
        <div class="bg-canvas px-6 py-8 font-display text-xl font-semibold md:px-8 md:text-2xl">{r}</div>
      ))}
    </div>
  </div>
</section>
