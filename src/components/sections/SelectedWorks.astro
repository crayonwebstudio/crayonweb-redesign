---
import { getCollection } from 'astro:content';
import VideoHoverCard from '../motion/VideoHoverCard.astro';
const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const spans = ['md:col-span-7', 'md:col-span-5', 'md:col-span-5', 'md:col-span-7', 'md:col-span-7', 'md:col-span-5'];
---

<section class="mx-auto max-w-[1440px] px-5 py-24 md:px-10 md:py-32">
  <div class="flex items-end justify-between gap-6 border-t border-hairline pt-6">
    <h2 class="font-display text-3xl font-semibold tracking-tight md:text-5xl">Selected Works</h2>
    <a href="/work" class="shrink-0 text-sm font-medium underline underline-offset-4">All work</a>
  </div>
  <div class="mt-12 grid gap-x-8 gap-y-16 md:grid-cols-12">
    {works.map((w, i) => (
      <VideoHoverCard
        href={`/work/${w.id.replace(/\.md$/, '')}`}
        cover={w.data.cover}
        hoverImage={w.data.hoverImage}
        initials={w.data.initials}
        title={w.data.title}
        disciplines={w.data.disciplines}
        year={w.data.year}
        span={spans[i % spans.length]}
        aspect={i % 2 === 0 ? 'aspect-[4/3]' : 'aspect-[4/3]'}
      />
    ))}
  </div>
</section>
